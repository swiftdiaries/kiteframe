{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AdmissionRequest",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "contextualFacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "delegationAncestry": {
      "$ref": "#/$defs/DelegationAncestry"
    },
    "lockDigest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "optionalCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequestedCapability"
      }
    },
    "portableDigest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequestedCapability"
      }
    },
    "resolvedDigest": {
      "$ref": "#/$defs/Sha256Digest"
    },
    "resolvedRequirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ResolvedCapabilityRequirement"
      }
    },
    "session": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "traceContext": {
      "$ref": "#/$defs/TraceContext"
    }
  },
  "additionalProperties": false,
  "required": [
    "actor",
    "agent",
    "task",
    "session",
    "portableDigest",
    "lockDigest",
    "resolvedDigest",
    "requiredCapabilities",
    "optionalCapabilities",
    "resolvedRequirements",
    "delegationAncestry",
    "contextualFacts",
    "traceContext"
  ],
  "$defs": {
    "BaggageCorrelationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "CapabilityIdentity": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/CapabilityName"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "CapabilityName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "DelegationAncestry": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "RequestedCapability": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/CapabilityIdentity"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "resources"
      ]
    },
    "ResolvedCapabilityRequirement": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/CapabilityIdentity"
        },
        "required": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "identity",
        "required",
        "resources"
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "TraceContext": {
      "type": "object",
      "properties": {
        "baggage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BaggageCorrelationId"
          }
        },
        "traceparent": {
          "type": "string",
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "tracestate": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[ -~]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "traceparent"
      ]
    }
  }
}
